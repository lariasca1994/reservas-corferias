APP_NAME="Reservas Corferias"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Azure SQL Database ---------------------------------------------------
# El servidor tiene la forma: <nombre-del-servidor>.database.windows.net
DB_CONNECTION=sqlsrv
DB_HOST=CAMBIAME.database.windows.net
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=false
# Margen para que la base serverless despierte tras una pausa
DB_LOGIN_TIMEOUT=30

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mapa (Leaflet + OpenStreetMap, sin clave ni cuenta) ------------------
MAPA_LAT=4.62967
MAPA_LNG=-74.09045
MAPA_ZOOM=16
MAPA_ETIQUETA="Centro de Convenciones Corferias"

# --- Correo ---------------------------------------------------------------
# En desarrollo, 'log' escribe los correos en storage/logs/laravel.log
# sin enviar nada. Para verlos con su diseño real, usa Mailpit o Mailtrap
# cambiando MAIL_MAILER=smtp y apuntando host y puerto.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="reservas@ejemplo.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Cuentas iniciales del panel (solo para el seeder) --------------------
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=
OPERADOR_PASSWORD=

# --- Almacenamiento -------------------------------------------------------
# Las imagenes subidas van a storage/app/public.
# Ejecutar una vez: php artisan storage:link
FILESYSTEM_DISK=public

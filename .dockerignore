# Cache de proveedores generado en tu maquina local (con paquetes de
# desarrollo como Pail o Sail incluidos). Si se copia tal cual a la imagen,
# "composer install --no-dev" los quita pero este cache viejo todavia los
# referencia, y "php artisan package:discover" falla con
# "Class ...PailServiceProvider not found". Se regenera solo en el build.
bootstrap/cache/*.php
